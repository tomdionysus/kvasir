statement CREATE TABLE kv_temporal.t (id INT PRIMARY KEY, d DATE, t TIME(3), dt DATETIME(6), ts TIMESTAMP NULL, y YEAR, dn DATE NOT NULL DEFAULT '2000-01-01')
end
