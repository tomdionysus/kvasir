#!/usr/bin/make -f
#
# Kvasir - The Distributed Relational Database
#
# Copyright (C) 2026 Tom Cully <mail@tomcully.com>
# Licensed under the GNU GPLv3 - see <https://www.gnu.org/licenses/gpl-3.0.html>
#
# The CMake install rules say where the binary goes; the rest (the settings,
# the unit, the user) is debian/'s. Dannan is the installed package
# (KVASIR_SYSTEM_DANNAN), never a copy, and Kvasir's own library is linked
# into kvasir-node.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

ifneq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
TESTS = OFF
else
TESTS = ON
endif

%:
	dh $@ --buildsystem=cmake --builddirectory=debian/build

override_dh_auto_configure:
	dh_auto_configure -- \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DKVASIR_SYSTEM_DANNAN=ON \
		-DKVASIR_BUILD_TESTING=$(TESTS)

# The test binary rather than ctest. Every connection the tests make is on
# the loopback interface.
override_dh_auto_test:
ifeq ($(TESTS),ON)
	debian/build/kvasir_tests
endif

# Installed, never enabled or started: a node needs its certificate, key and
# accounts first (README, "Run a node").
override_dh_installsystemd:
	dh_installsystemd --no-enable --no-start
