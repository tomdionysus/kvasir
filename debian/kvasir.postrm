# Purging removes what postinst made; the certificate and key are the
# operator's and stay.

set -e

if [ "$1" = purge ]; then
  rm -f /etc/kvasir/secrets.yaml
  rm -rf /var/lib/kvasir
fi

#DEBHELPER#

exit 0
